# 복사 후 .env 로 저장 (저장소에 커밋하지 마세요)
PORT=3001
NODE_ENV=development

# openssl rand -base64 48 로 생성 권장 (최소 32바이트 이상)
JWT_SECRET=change-me-to-a-long-random-string

# 브라우저 출처(CORS·쿠키 SameSite 맥락). 쉼표로 여러 개 허용 가능합니다.
# 예: FRONTEND_ORIGIN=https://app.example.com,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# 역프록시(Nginx, Cloudflare 등) 뒤에 둘 때 X-Forwarded-For 등을 신뢰하는 홉 수.
# 미설정 시 1. 0 이면 trust proxy 비활성화(로컬 단독 실행에 가깝게).
# TRUST_PROXY_HOPS=1

# 가입 사용자 JSON 저장 경로. 비우면 기본값 server/data/users.json (userStore 기준).
# USERS_STORE_PATH=

# 로그인 admin / admin 은 NODE_ENV 가 production 이 아닐 때만 동작합니다.
